# ---------------------------------------------------------------------------
# The Fragrance House — environment configuration
# Copy to .env (`cp .env.example .env`) and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# Database. Local development uses SQLite (zero setup). For production use PostgreSQL:
# change `provider` in prisma/schema.prisma to "postgresql" and set e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/fragrance?schema=public"
DATABASE_URL="file:./dev.db"

# Public base URL (used for canonical URLs, sitemap, payment callbacks, emails)
APP_URL="http://localhost:3000"

# Secret used to sign session-related values. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-only-change-me"

# Seed: creates the first super-admin. Development test credentials only.
ADMIN_SEED_EMAIL="admin@fragrancehouse.test"
ADMIN_SEED_PASSWORD="ChangeMe-Admin-2026!"
# Seed clearly-labelled TEST stock + test warehouse so checkout can be exercised locally.
# Set to "false" for production seeds (stock then starts at 0 until real GRNs are recorded).
SEED_TEST_DATA="true"

# --- Payments: Razorpay (India: UPI, cards, net banking, wallets) -----------
# Leave blank to keep Razorpay in the "awaiting credentials" state.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Local payment sandbox (no real money, never contacts a bank). Refuses to run when
# NODE_ENV=production unless PAYMENTS_SANDBOX_ENABLED is explicitly "true".
PAYMENTS_SANDBOX_ENABLED="true"
PAYMENTS_SANDBOX_SECRET="dev-sandbox-secret-change-me"

# --- Messaging --------------------------------------------------------------
# Email (Resend-compatible HTTP API). Blank = messages are recorded in the admin Outbox as NOT_CONFIGURED.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="The Fragrance House <hello@example.com>"
# WhatsApp Cloud API (Meta). Blank = NOT_CONFIGURED.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- Shipping ---------------------------------------------------------------
# Shiprocket API credentials. Blank = delivery estimates use the admin-configured PIN-code rules only.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""

# --- Analytics --------------------------------------------------------------
# GA4 Measurement Protocol (server-side forwarding). Blank = events stored first-party only.
GA4_MEASUREMENT_ID=""
GA4_API_SECRET=""
